PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=structured_stack
LOG_LEVEL=debug
LOG_STACK=structured_daily,database_logs,performance_logs
LOG_DAILY_DAYS=30
LOG_MAX_FILES=10

# Structured Logging
LOG_FORMAT=json
LOG_INCLUDE_CONTEXT=true
LOG_INCLUDE_EXTRA=true

# Performance Logging
LOG_SLOW_QUERIES=true
LOG_SLOW_QUERY_THRESHOLD=1000

# User Activity Logging
LOG_USER_ACTIVITIES=true
LOG_API_REQUESTS=true

# Error Tracking
LOG_ERROR_CONTEXT=true
LOG_STACK_TRACES=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
